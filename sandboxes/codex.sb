;; ==========================================================================
;; Codex CLI -- profile-specific Seatbelt rules
;; ==========================================================================
;; Concatenated after common.sb by Fluent when launching Codex.
;;
;; NOTE: No (allow iokit*) -- Codex is a CLI tool, not a GUI app.
;; It does not need Metal GPU enumeration or any IOKit services.
;;
;; Codex-specific rules should live here so common.sb can remain shared
;; infrastructure for all local sandboxed coders.
;; ==========================================================================

;; The caller resolves this to the interactive Source home or the private
;; autonomous Worker home. Do not replace it with a broad user-home grant.
(allow file-read*  (subpath "_CODEX_HOME_"))
(allow file-write* (subpath "_CODEX_HOME_"))
